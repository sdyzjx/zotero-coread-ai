{
  "name": "zotero-coread-ai",
  "version": "0.4.0",
  "private": true,
  "description": "CoRead AI (AI 伴读): co-read papers with AI in Zotero — attention-guiding outline, in-context questions and annotations; DeepSeek, Claude Code, Codex or Antigravity",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build:public": "node scripts/build.mjs --public",
    "site": "node scripts/site.mjs",
    "deploy:site": "node scripts/site.mjs && npx wrangler@4 deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-ai": "^1.3.0",
    "katex": "^0.16.22",
    "markdown-it": "^15.0.3",
    "mermaid": "^11.12.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "esbuild": "^0.25.11",
    "typescript": "^5.9.3",
    "zotero-types": "^4.1.3"
  }
}
